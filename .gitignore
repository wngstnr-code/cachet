# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# move
contracts/**/build/

# foundry (Person B)
contracts/out/
contracts/cache/
contracts/broadcast/**/dry-run/
# Hanya `*-latest.json` yang di-track: berisi alamat & tx hash hasil deploy —
# bukti on-chain yang dirujuk README dan dibaca script/verify-sourcify-v2.py.
# Salinan bertimestamp isinya identik dengan run-latest.json, jadi men-track-nya
# hanya menambah puluhan file tanpa menambah satu pun bukti baru.
contracts/broadcast/**/run-[0-9]*.json

# env — NEVER commit real secrets (private keys, API keys, Supabase creds)
# `.env.*` (bukan cuma `.env.local`) karena deploy per-chain memakai file
# terpisah seperti .env.mainnet — pola lama tidak menangkapnya, dan file berisi
# DEPLOYER_PK mainnet yang lolos ke git tidak bisa ditarik kembali.
.env
.env.*
*.local
env-*.txt

# Template WAJIB tetap ter-track — pengecualian ini harus di bawah `.env.*`,
# kalau tidak polanya menelan template juga dan onboarding jadi rusak.
!.env.example
!.env.mainnet.example
.env.mainnet

# logs
*.log
npm-debug.log*

# editor / os
.DS_Store
.idea/
.vscode/

# state agent lokal — bukan bagian dari produk, tidak untuk publik/juri
task.txt
graphify-out/
.agents/
skills-lock.json
.claude/

# hasil deploy Vercel
.vercel

# Dokumen perencanaan internal, rekaman demo, dan project video Remotion.
# Tetap ada di disk lokal — TIDAK terekam git, jadi tidak bisa dipulihkan
# lewat git kalau folder ini terhapus.
docs/
