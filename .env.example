# =============================================================================
# CACHET — template environment (SATU file .env untuk seluruh monorepo)
#
# CARA PAKAI:  cp .env.example .env   lalu isi nilainya.
# File .env NYATA tidak boleh di-commit (sudah masuk .gitignore). Lihat docs §0.
#
# Referensi: docs/technical_implementation_plan.md §8.1 (cara tiap stack
# membaca file ini — Vite butuh envDir, Foundry butuh `source ../.env`).
# =============================================================================

# --- Chain: X Layer Testnet (§1.4) -------------------------------------------
# VERIFIKASI ulang RPC di web3.okx.com/xlayer saat H1 — endpoint pernah berubah.
RPC_URL=https://testrpc.xlayer.tech
CHAIN_ID=1952

# --- Alamat kontrak ----------------------------------------------------------
# Diisi H3 malam dari packages/contracts-abi/addresses.testnet.json (kiriman B).
ADDR_REGISTRY=
ADDR_CERTIFICATE=
ADDR_VAULT=
ADDR_CHALLENGE=
ADDR_MOCKUSDT=

# --- Wallet: TIGA key TERPISAH, semuanya BARU & testnet-only (§0, §9.6) ------
# Jangan reuse key lama. Jangan pakai wallet berisi dana mainnet.
GATEWAY_PK=                       # [A] penandatangan EIP-712 + pengirim tx mint
DEPLOYER_PK=                      # [B] deployer kontrak
RESOLVER_ADDR=                    # [B] address resolver — BUKAN deployer, BUKAN gateway
GATEWAY_ADDR=                     # [B] address publik dari GATEWAY_PK, dikirim A ke B di H1

# --- Service off-chain [A] ---------------------------------------------------
ENGINE_PORT=8100
ENGINE_URL=http://localhost:8100
INDEX_PATH=./data/index
GATEWAY_PORT=8787
CERT_PAGE_BASE=                   # URL pattern dari B, H4 (https://…/cert/:id)

# --- x402 / OKX Payment SDK [A] ----------------------------------------------
X402_BYPASS=0                     # 1 = dev lokal saja; WAJIB 0 di deployment yang dilisting

# --- Watch worker [A] --------------------------------------------------------
CRON_SCHEDULE="0 */6 * * *"
WEBHOOK_URL=

# --- Certificate page [B] ----------------------------------------------------
# HANYA var VITE_* yang terekspos ke browser — jangan pernah taruh private key di sini.
VITE_RPC_URL=https://testrpc.xlayer.tech
VITE_ADDRESSES=                   # path ke packages/contracts-abi/addresses.testnet.json

# --- Demo safety net (§13) ---------------------------------------------------
DEMO_MODE=0                       # 1 = balas dari fixture; WAJIB 0 di deployment yang dilisting
