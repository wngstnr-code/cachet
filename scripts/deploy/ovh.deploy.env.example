# Copy to /opt/cachet/deploy.env (root:root 0600) and replace both values with
# images carrying the SAME full Git commit SHA. Never use `latest` in production.
ENGINE_IMAGE=ghcr.io/scientivan/cachet-engine:sha-REPLACE_WITH_FULL_GIT_SHA
GATEWAY_IMAGE=ghcr.io/scientivan/cachet-gateway:sha-REPLACE_WITH_FULL_GIT_SHA

# Persistent bind-mount root on the VPS.
CACHET_DATA_ROOT=/var/lib/cachet

# Runtime secret file on the VPS.
CACHET_RUNTIME_ENV=/opt/cachet/.env

# Sertifikat yang dipakai smoke test publik untuk membuktikan GET /v1/cert/:id
# melayani data nyata. Isi dengan id sertifikat yang BENAR-BENAR ADA di chain
# deployment ini.
#
# Setel `none` pada deployment yang registry-nya masih kosong -- mainnet yang baru
# berdiri belum menerbitkan sertifikat apa pun, jadi id berapa pun akan membuat
# kontrak revert dan gateway menjawab 400. `none` melewati pemeriksaan itu SECARA
# EKSPLISIT; ia tidak pernah menelan kegagalan dari id yang benar-benar disetel.
# Ganti ke id nyata begitu sertifikat pertama terbit.
CACHET_SMOKE_CERT_ID=none
