# Cachet runtime configuration for /opt/cachet/.env.
# This file is a key list only. Never commit the filled production file.

# X Layer testnet
RPC_URL=https://testrpc.xlayer.tech
CHAIN_ID=1952
CHAIN_MODE=viem

# Live contract addresses supplied by Person B / testnet deployment.
ADDR_REGISTRY=
ADDR_CERTIFICATE=
ADDR_VAULT=
ADDR_CHALLENGE=
ADDR_MOCKUSDT=

# Testnet-only gateway signer. Must be exactly 0x + 64 hex characters.
GATEWAY_PK=

# Public certificate page and x402 v2 seller configuration.
CERT_PAGE_BASE=
X402_NETWORK=eip155:1952
X402_PAY_TO=
X402_RESOURCE_BASE=https://api.cachetprotocol.xyz
OKX_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Mandatory production safety switches.
X402_BYPASS=0
DEMO_MODE=0

# ENGINE_EMBEDDER is intentionally absent: compose.ovh.yml pins it to `fake`.
# Enabling CLIP requires a 4-vCore/8-GB upgrade or a separate Cachet host.
